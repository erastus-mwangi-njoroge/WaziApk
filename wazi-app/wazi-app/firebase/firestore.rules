rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles — anyone signed in can read (needed to show owner names
    // on listings you didn't create), but you can only create/edit your own.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Listings are public to browse (even signed-out visitors), but only
    // the owner who created one can edit or delete it, and the ownerId on
    // create must match the signed-in user (no posting on someone else's behalf).
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Tenant vacancy-alert preferences — private to that tenant.
    match /preferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Notifications are written by the notifyMatchingTenants Cloud Function
    // (Admin SDK, bypasses these rules) — clients can only read their own
    // and mark their own as read, never create or delete them directly.
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
  }
}
