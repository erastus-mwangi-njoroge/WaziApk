rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{listingId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}

// Note: this doesn't verify the uploader owns `listingId`'s Firestore
// document — it only checks the file is an image under 8MB from a signed-in
// user. Good enough for a first deployment; if you want to close that gap,
// pre-generate the listing doc first (already the client's pattern — see
// ListingsService.create) and have these rules call
// firestore.get(/databases/(default)/documents/listings/$(listingId)).data.ownerId == request.auth.uid
// once the doc exists — trickier for the very first upload since the
// Firestore doc and Storage files are written in sequence from the client.
